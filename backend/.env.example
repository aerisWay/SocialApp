# ============================================================
# .env.example — Plantilla de variables de entorno
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena los valores reales en el nuevo .env
# 3. NUNCA subas el archivo .env a Git (ya está en .gitignore)

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/socialapp_db

# --- Seguridad JWT ---
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-generada-aleatoriamente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Entorno ---
ENVIRONMENT=development
DEBUG=True

# --- Nombre de la app ---
APP_NAME=SocialApp
